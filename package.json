{
  "name": "routine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Routine — a complete personal life operating system",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch server/index.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.mjs",
    "reset": "node --disable-warning=ExperimentalWarning server/seed.mjs --reset",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test server/tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
